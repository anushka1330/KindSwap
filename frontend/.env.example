# Backend API Base URL
VITE_API_URL=http://localhost:5000/api

# Optional: Custom Map Tile Style / Provider (MapLibre GL JS compatible)
# Defaults to high-performance warm CartoDB Voyager tiles (OpenStreetMap data) matching KindSwap palette
# If using MapTiler: https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_API_KEY
# If using custom vector tiles:
# VITE_MAP_STYLE_URL=
# If using custom raster tile URL template:
# VITE_MAP_TILES_URL=https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}@2x.png
